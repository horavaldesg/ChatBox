generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatPlatform {
  TWITCH
  KICK
  X
  MOCK
}

enum OverlayTheme {
  DARK
  LIGHT
  NEON
  MINIMAL
}

enum AnimationStyle {
  NONE
  FADE
  SLIDE
  POP
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  passwordHash      String
  image             String?
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  connectedAccounts ConnectedAccount[]
  overlays          Overlay[]
  auditLogs         AuditLog[]
}

model ConnectedAccount {
  id                    String       @id @default(cuid())
  userId                String
  provider              ChatPlatform
  providerAccountId     String
  username              String
  displayName           String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime?
  scopes                String[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Overlay {
  id                String          @id @default(cuid())
  userId            String
  name              String
  theme             OverlayTheme    @default(DARK)
  fontSize          Int             @default(22)
  fontFamily        String          @default("Inter, Arial, sans-serif")
  backgroundOpacity Float           @default(0.65)
  animationStyle    AnimationStyle  @default(FADE)
  platformBadges    Boolean         @default(true)
  messageLifetime   Int             @default(18)
  profanityFilter   Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             OverlayToken?
  messages          ChatMessage[]

  @@index([userId])
}

model OverlayToken {
  id        String   @id @default(cuid())
  overlayId String   @unique
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  overlay   Overlay  @relation(fields: [overlayId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String       @id
  overlayId   String
  platform    ChatPlatform
  username    String
  displayName String
  avatarUrl   String?
  message     String
  timestamp   DateTime
  badges      String[]
  createdAt   DateTime     @default(now())
  overlay     Overlay      @relation(fields: [overlayId], references: [id], onDelete: Cascade)

  @@index([overlayId, timestamp])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
